{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetObjectOnSitePrefix",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3055/site/*"
    },
    {
      "Sid": "AllowListBucketWithSitePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3055",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "site/",
            "site/*"
          ]
        }
      }
    }
  ]
}
